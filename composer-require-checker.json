{
    "symbol-whitelist": [
        "Yii3\\Debug\\Middleware\\ToolbarMiddleware"
    ],
    "php-core-extensions": [
        "Core",
        "date",
        "filter",
        "json",
        "pcre",
        "Phar",
        "random",
        "Reflection",
        "SPL",
        "standard"
    ],
    "scan-files": [
        "public/index.php",
        "yii"
    ]
}
